# ── Database ──────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=logistics_crm
DB_USER=root
DB_PASS=

# ── Redis (Queue + Cache) ─────────────────────────────────────────────────
# Install: apt install redis-server  /  yum install redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=
REDIS_DB=0

# ── API Security ──────────────────────────────────────────────────────────
CLEANUP_API_KEY=
DISCHARGE_EFFICIENCY_API_KEY=

# ── Worker ────────────────────────────────────────────────────────────────
# Cron: * * * * * php /var/www/api/process_shipment_sync_jobs.php 50 >> /var/log/nawris_worker.log 2>&1
WORKER_MAX_BATCH=50

# ══════════════════════════════════════════════════════════════════════════
# MySQL my.cnf recommended settings (add to [mysqld] section):
# ══════════════════════════════════════════════════════════════════════════
#
# innodb_buffer_pool_size     = 1G          # 70-80% of available RAM
# innodb_log_file_size        = 256M
# innodb_flush_log_at_trx_commit = 2        # safer for bulk imports
# innodb_io_capacity          = 400
# query_cache_type            = 0           # disable — causes mutex contention
# query_cache_size            = 0
# slow_query_log              = 1
# slow_query_log_file         = /var/log/mysql/slow.log
# long_query_time             = 1           # log queries > 1 second
# max_connections             = 150
# wait_timeout                = 60
# interactive_timeout         = 60
#
# ══════════════════════════════════════════════════════════════════════════
# Supabase (PostgreSQL) recommended indexes — run in Supabase SQL editor:
# ══════════════════════════════════════════════════════════════════════════
#
# CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_shipments_view_status
#     ON shipments_view (status);
#
# CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_shipments_view_delay
#     ON shipments_view (delay_days DESC);
#
# CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_shipments_view_driver
#     ON shipments_view (driver_id);
#
# CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_settings_key
#     ON settings (key);
#
# CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_contact_results_shipment
#     ON contact_results (shipment_id);
#
# VACUUM ANALYZE shipments_view;
# VACUUM ANALYZE settings;
